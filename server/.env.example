# Copy this file to server/.env and fill in real values. Never commit server/.env.
PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. .../parentsofkhan?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string
# Exact frontend origin(s) allowed by CORS; comma-separate multiple. No wildcard.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when the API runs behind a single reverse proxy / load balancer (Render, Railway, Fly, nginx...).
# TRUST_PROXY=1
# Auth uses an HttpOnly session cookie (Secure when NODE_ENV=production). No JWT secret is needed.
# In production the frontend and API should share a registrable domain (e.g. parentsofkhan.com and
# api.parentsofkhan.com) so the SameSite=Lax cookie is sent.

# ---- Admin dashboard ----
# Initial Master Admin (the single owner account). Set both, start the server (or run `npm run bootstrap-admin`),
# sign in at /admin/login, then DELETE the password line. It is never used again and never resets an existing account.
# MASTER_ADMIN_EMAIL=owner@example.com
# MASTER_ADMIN_INITIAL_PASSWORD=choose-a-long-unique-passphrase
# Product/category image uploads are saved to this folder (relative to server/). Back it up; see README for hosting notes.
# UPLOAD_DIR=uploads
# Only if the API and the website are on different domains: the public https URL of the API, so stored image URLs are absolute.
# PUBLIC_UPLOAD_BASE_URL=https://api.example.com

# ---- Cloudinary (optional; without it, images are stored on local disk as before) ----
# Create a free account at https://cloudinary.com, then copy these from Console > Dashboard > API Keys.
# ALL THREE live ONLY in this server file. Never put the secret in client/.env or any VITE_ variable.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Folder inside your Cloudinary media library (the app only ever deletes images under this folder).
# CLOUDINARY_FOLDER=parent-of-khan
# Originals larger than this (pixels, longest side) are scaled down once at upload. Default 2400.
# CLOUDINARY_MAX_DIMENSION=2400
# Largest allowed upload in megabytes (0.5-20). Default 5.
# UPLOAD_MAX_MB=5

# --- Safepay online payments (SANDBOX / test mode only in this build) ---------------------------------
# AFTER EDITING THIS FILE, RESTART THE API (stop `npm run dev` and start it again). `node --watch` does NOT reload .env.
# Then check your setup without using checkout:  npm run check:safepay   (add  :live  to also call Safepay's sandbox)
# Where Safepay sends the customer back after paying. Defaults to the first CLIENT_ORIGIN. No path, no trailing slash.
# PUBLIC_SITE_URL=http://localhost:5173
#
# Always "sandbox" here. "production" is refused on purpose: live payments are not enabled in this build.
SAFEPAY_ENV=sandbox
# Safepay dashboard (Sandbox) > Developers. THREE DIFFERENT values: do not paste one into another's slot.
# Public API Key: starts with "sec_". Safe to appear in a payment request, but still keep it server-side.
SAFEPAY_PUBLIC_KEY=
# Secret API Key. SERVER ONLY. Never put it in the client, a VITE_ variable, git, chat or logs.
SAFEPAY_SECRET_KEY=
# Webhook shared secret: Developers > Endpoints > your sandbox endpoint > "View shared secret".
# It is NOT the API secret key. SERVER ONLY.
SAFEPAY_WEBHOOK_SECRET=

# ---- WhatsApp checkout (the ONLY customer checkout while online gateways are off) ----
# YOUR WhatsApp Business number, international format, DIGITS ONLY: country code first, no "+", no spaces, no leading 0.
# Pakistan example for 0300 1234567:  923001234567.  Until this is set, the checkout button is unavailable and no order is created.
# Free Click-to-Chat (wa.me) links only: no WhatsApp Business API, no paid messaging. The number is public by nature (it appears in the link).
WHATSAPP_BUSINESS_NUMBER=

# ---- Online payment gateways (Safepay) ----
# OFF unless this is exactly "true". The Safepay code, routes, webhook handler and SAFEPAY_* variables below are all kept; this switch decides
# whether customers can reach them. To re-enable later: set ENABLE_ONLINE_PAYMENTS=true, fill the SAFEPAY_* values, restart the API.
# (The storefront checkout button for online payment must also be restored in client/src/pages/Checkout.jsx; see README.)
ENABLE_ONLINE_PAYMENTS=false
