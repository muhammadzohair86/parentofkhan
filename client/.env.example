# Development needs no settings: Vite proxies /api to http://localhost:5000.
# Only set these if your backend runs elsewhere.
# VITE_PROXY_TARGET=http://localhost:5000   (dev proxy target)
# VITE_API_URL=https://api.example.com/api  (production API base; leave unset in dev)

# Optional. Your Cloudinary CLOUD NAME (public: it already appears in every image URL). When set, only images from
# this cloud are optimized. NEVER put the API key or API secret in any client variable.
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
