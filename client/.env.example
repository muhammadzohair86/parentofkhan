# Development needs no settings: Vite proxies /api to http://localhost:5000.
# Only set these if your backend runs elsewhere.
# VITE_PROXY_TARGET=http://localhost:5000   (dev proxy target)
# VITE_API_URL=https://api.example.com/api  (production API base; leave unset in dev)
#
# PRODUCTION (Netlify): VITE_* values are baked in at BUILD time. Set VITE_API_URL in Netlify > Site configuration > Environment variables,
# then trigger a new deploy (changing it does nothing until you rebuild). It must be the full API base INCLUDING /api, no trailing slash,
# and the backend's CLIENT_ORIGIN must exactly equal this site's origin (e.g. https://www.parentsofkhan.com).
# If you leave it unset, the site calls /api on its OWN domain: that only works if Netlify proxies /api/* to your backend (client/public/_redirects).

# Optional. Your Cloudinary CLOUD NAME (public: it already appears in every image URL). When set, only images from
# this cloud are optimized. NEVER put the API key or API secret in any client variable.
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
